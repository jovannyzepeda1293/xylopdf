generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int           @id @default(autoincrement())
  email              String        @unique @db.VarChar(255)
  name               String?       @db.VarChar(255)
  googleId           String?       @unique @map("google_id") @db.VarChar(255)
  avatarUrl          String?       @map("avatar_url")
  isActive           Boolean?      @default(true) @map("is_active")
  createdAt          DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  passwordHash       String?       @map("password_hash")
  isConfirmed        Boolean?      @default(false) @map("is_confirmed")
  confirmationToken  String?       @unique @map("confirmation_token") @db.VarChar(255)
  resetToken         String?       @unique @map("reset_token") @db.VarChar(255)
  resetTokenExpires  DateTime?     @map("reset_token_expires") @db.Timestamp(6)
  dailyConversions   Int           @default(0) @map("daily_conversions")
  lastConversionDate DateTime      @default(now()) @map("last_conversion_date") @db.Timestamp(6)
  subscription       Subscription?

  @@index([email])
  @@index([confirmationToken])
  @@map("users")
}

model GuestUsage {
  id                 Int      @id @default(autoincrement())
  ip                 String   @unique
  count              Int      @default(0)
  lastConversionDate DateTime @default(now()) @map("last_conversion_date")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("guest_usage")
}

model Subscription {
  id              Int       @id @default(autoincrement())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int       @unique @map("user_id")
  lastPaymentDate DateTime? @map("last_payment_date") @db.Timestamp(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamp(3)
  status          Int?
  customerId      String?   @unique @map("customer_id")
  subscriptionId  String?   @unique @map("subscription_id")
  canceled        Boolean   @default(false)
  country         String?   @db.VarChar(10)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("subscriptions")
}
